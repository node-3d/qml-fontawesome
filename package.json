{
	"author": "Luis Blanco <luisblanco1337@gmail.com>",
	"name": "@node-3d/qml-fontawesome",
	"version": "1.0.2",
	"description": "FontAwesome 6+ icons for QML",
	"license": "MIT",
	"main": "dist/index.js",
	"keywords": [
		"qt",
		"qml",
		"fontawesome",
		"icons",
		"qtquick",
		"fontawesome6"
	],
	"files": [
		"dist",
		"FontAwesome",
		"LICENSE"
	],
	"scripts": {
		"i": "npm install --workspaces=false",
		"example": "cd examples && node main.ts",
		"lint:oxlint": "oxlint .",
		"lint:all": "npm run lint:ts && npm run lint:ts:consumer && npm run lint:oxlint",
		"build:ci": "rslib build",
		"build:watch": "rslib build --watch",
		"lint:ts": "tsc -p tsconfig.json --noEmit",
		"lint:ts:consumer": "tsc -p test-consumer/tsconfig.json --noEmit",
		"test:ci": "npm run build:ci && node --test \"test/**/*.test.ts\"",
		"prepack": "npm run build:ci",
		"format:ts": "oxfmt -c ./oxfmt.config.ts --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx}\"",
		"format:ts:ci": "oxfmt -c ./oxfmt.config.ts --check --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx}\""
	},
	"engines": {
		"node": ">=22.18.0",
		"npm": ">=10.9.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/node-3d/qml-fontawesome.git"
	},
	"dependencies": {},
	"type": "module",
	"devDependencies": {
		"@node-3d/core": "~6.4.1",
		"@node-3d/plugin-qml": "~5.0.2",
		"@types/three": "0.186.0",
		"@node-3d/addon-tools": "~10.2.0",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2003",
		"tslib": "2.8.1",
		"three": "0.186.1",
		"@rslib/core": "1.0.2",
		"@types/node": "24.19.0",
		"oxfmt": "0.70.0",
		"typescript": "7.0.2"
	},
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bugs": {
		"url": "https://github.com/node-3d/node-3d/issues"
	},
	"homepage": "https://github.com/node-3d/node-3d#readme",
	"publishConfig": {
		"access": "public"
	}
}
